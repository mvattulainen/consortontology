{
  "$id": "https://example.org/consort/schemas/vault-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "type": "object"
    },
    "files": {
      "maxItems": 42,
      "minItems": 42,
      "type": "array"
    },
    "guideline": {
      "const": "consort-2025"
    },
    "requiredLeafItems": {
      "maxItems": 42,
      "minItems": 42,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "1.0"
    }
  },
  "required": [
    "schemaVersion",
    "guideline",
    "requiredLeafItems",
    "files",
    "counts"
  ],
  "title": "Vault manifest",
  "type": "object"
}
