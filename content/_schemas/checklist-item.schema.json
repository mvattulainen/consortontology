{
  "$id": "https://example.org/consort/schemas/checklist-item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entity": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "pattern": "^consort-2025-item-[0-9]+[a-z]?$",
          "type": "string"
        },
        "item_number": {
          "pattern": "^[0-9]+[a-z]?$",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$id": "https://example.org/consort/schemas/atomic-requirement.schema.json",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": true,
            "if": {
              "properties": {
                "normative_strength": {
                  "const": "conditional_must"
                }
              }
            },
            "properties": {
              "applicability_condition": {
                "type": "string"
              },
              "id": {
                "pattern": "^consort-2025-item-[0-9]+[a-z]?-r[0-9]{2}$",
                "type": "string"
              },
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "normative_strength": {
                "enum": [
                  "must",
                  "conditional_must",
                  "should",
                  "may",
                  "explanatory"
                ]
              },
              "parent_item": {
                "type": "string"
              },
              "requirement_text": {
                "minLength": 1,
                "type": "string"
              },
              "source_references": {
                "items": {
                  "properties": {
                    "locator": {
                      "minProperties": 1,
                      "type": "object"
                    },
                    "source": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "source",
                    "locator"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "status": {
                "enum": [
                  "draft",
                  "reviewed",
                  "approved",
                  "deprecated"
                ]
              },
              "type": {
                "const": "AtomicRequirement"
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "status",
              "parent_item",
              "requirement_text",
              "normative_strength",
              "source_references"
            ],
            "then": {
              "required": [
                "applicability_condition"
              ]
            },
            "title": "Atomic requirement",
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "section": {
          "enum": [
            "consort-2025-section-title-and-abstract",
            "consort-2025-section-open-science",
            "consort-2025-section-introduction",
            "consort-2025-section-methods",
            "consort-2025-section-results",
            "consort-2025-section-discussion"
          ]
        },
        "source_references": {
          "items": {
            "properties": {
              "locator": {
                "minProperties": 1,
                "type": "object"
              },
              "source": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "source",
              "locator"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "approved",
            "deprecated"
          ]
        },
        "type": {
          "const": "ChecklistItem"
        }
      },
      "required": [
        "id",
        "type",
        "item_number",
        "label",
        "section",
        "topic",
        "status",
        "requirements",
        "source_references"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "entity"
  ],
  "title": "Canonical checklist item record",
  "type": "object"
}
